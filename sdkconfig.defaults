# Required to build on ESP-IDF v5.5.3+
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_SIZE_IN_BYTES=0x7000

CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_TARGET_ESP32P4=y

CONFIG_ARDUINO_VARIANT="esp32p4"

# Required to build on ESP-IDF v6.0.2+
CONFIG_LIBC_NEWLIB=y

# ==============================================================================
# COMPILER WARNING CONFIGURATION
# ==============================================================================
# CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y is required to ensure compatibility
# with ESP-IDF v5.5.5+ and v6.0.2 when building the 'arduino-esp32' managed
# component framework layer.
#
# The upstream third-party 'arduino-esp32' code contains legacy structural 
# properties that trigger strict compiler warnings.Leaving this flag disabled
# forces the build toolchain to treat these non-fatal vendor library warnings
# as breaking compilation errors, halting the firmware build pipeline. Leaving
# this set to 'y' safely isolates our core project logic from external library
# framework maintenance updates.
# ============================================================================
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# allows up to 64 NTP requests to be serviced concurrently
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_ETH_TRANSMIT_MUTEX=y
CONFIG_ETH_DMA_RX_BUFFER_NUM=30
CONFIG_ETH_DMA_TX_BUFFER_NUM=30
CONFIG_ETH_IRAM_OPTIMIZATION=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Compiler optimization for performance (-O2) instead of debug (-Og): shorter and steadier NTP and PPS code paths
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ==============================================================================
# WEB ADMIN PAGE (HTTPS, TCP 443)
# ==============================================================================
# After changing these values delete the file sdkconfig (or run "idf.py fullclean" and delete it), otherwise
# the values already stored in sdkconfig stay in effect. main/web/web_net.cpp stops the build with an error if
# the ND6 gateway hook is missing.
#
# Self-signed certificate created on the device (X.509 writing)
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PK_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
# TLS 1.2 and TLS 1.3 (with ECDHE), no renegotiation
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK is not set
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL is not set
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# Allocate the TLS record buffers only while they are used (about 40 kB less per idle connection)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# Browsers send long request headers (cookies, client hints)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# Static IPv6 default gateway (lwIP has no API for it): lwip_hook_nd6_get_gw() in main/web/web_net.cpp
CONFIG_LWIP_HOOK_ND6_GET_GW_CUSTOM=y
# Link-local + SLAAC (global and unique local) + the static IPv6 address of the web settings + one spare
CONFIG_LWIP_IPV6_NUM_ADDRESSES=5
# IPv6 DNS servers from router advertisements (RDNSS, RFC 8106); the DNS manager in main/web/web_net.cpp
# combines them with the DHCPv4 servers
CONFIG_LWIP_IPV6_RDNSS_MAX_DNS_SERVERS=2
# DHCPv4 and RDNSS pass their DNS servers to the DNS manager (callback) instead of writing the DNS table
CONFIG_LWIP_DNS_SETSERVER_WITH_NETIF=y
